[Unit]
Description=Stroka rhyme analysis
After=network.target

[Service]
Type=simple
User=stroka
Group=stroka
WorkingDirectory=/srv/stroka/rhyme-server
Environment=NLTK_DATA=/srv/stroka/nltk_data
ExecStart=/srv/stroka/rhyme-server/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8002
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
